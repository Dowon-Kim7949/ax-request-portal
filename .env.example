# Copy to .env.local and adjust. Values here are placeholders only.

# Public path the app is served from. "/" for a domain root, "/ax/" for https://host/ax/
VITE_BASE=/

# true: run against the in-browser mock API (MSW). No backend needed — good for demos.
# false: call the real backend at VITE_API_BASE_URL.
VITE_API_MOCK=true

# Base URL of the backend that implements docs/openapi contract (used when VITE_API_MOCK=false)
VITE_API_BASE_URL=https://api.example.internal
