# Copy to .env.local and adjust. Values here are placeholders only.
# `vite build` checks these (src/config/env-check.ts) and stops with a clear
# message on a bad value; the dev server prints the same findings as warnings.

# Public path the app is served from. "/" for a domain root, "/ax/" for https://host/ax/
VITE_BASE=/

# true (or unset): demo mode. The in-browser mock API (MSW) answers every call,
# so no backend is needed, but whatever people enter stays in their own
# browser. Every screen shows a "demo mode" banner.
# false: call the real backend at VITE_API_BASE_URL. No banner, and the mock
# service worker is left out of dist/.
# Any other value (TRUE, yes, 0, a typo) fails the build.
VITE_API_MOCK=true

# The backend that implements docs/openapi.json. Required when VITE_API_MOCK=false,
# ignored otherwise. Either a same-origin path such as /api (proxied by nginx,
# see deploy/nginx.conf) or a full http(s) URL without credentials, query or
# fragment. The build refuses a missing value, a non-URL and this placeholder.
# A backend on another origin must also be added to connect-src in the
# Content-Security-Policy (deploy/nginx.conf) and allow the app's origin (CORS).
VITE_API_BASE_URL=https://api.example.internal

# Optional build id written to version.json; open tabs offer a reload when it changes.
# Defaults to the commit (GITHUB_SHA or git), else the build time.
# VITE_BUILD_ID=
